Output docs/videos/opencode-maas-demo.mp4

Set Shell "zsh"
Set FontSize 20
Set Width 1400
Set Height 800
Set Padding 24
Set TypingSpeed 35ms
Set PlaybackSpeed 1.2
Set Theme { "name": "Private MaaS", "black": "#151515", "red": "#ee0000", "green": "#3e8635", "yellow": "#f0ab00", "blue": "#0066cc", "magenta": "#6753ac", "cyan": "#00b9e4", "white": "#f2f2f2", "brightBlack": "#6a6e73", "brightRed": "#ff4d4d", "brightGreen": "#92d400", "brightYellow": "#f4c145", "brightBlue": "#73bcf7", "brightMagenta": "#a18fff", "brightCyan": "#a2d9d9", "brightWhite": "#ffffff", "background": "#151515", "foreground": "#f2f2f2", "selectionBackground": "#3c3f42", "cursorAccent": "#151515", "cursor": "#ee0000" }

Type "scripts/run-opencode-maas-demo.sh"
Enter
Sleep 30s
